---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Your name | Portfolio',
  description = 'A simple portfolio site for your work, background, and contact details.',
} = Astro.props;

const backgroundImages = [
  'wallhaven-13lzov.webp',
  'wallhaven-4l3qxp.webp',
  'wallhaven-gp8lpd.webp',
  'wallhaven-mpdx9y.webp',
  'wallhaven-nmmvvk.webp',
  'wallhaven-nr87vj.webp',
  'wallhaven-vmojp3.webp',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="background-image-field" data-backgrounds={backgroundImages.map((image) => `/backgrounds/${image}`).join('|')} aria-hidden="true">
      <img class="background-image is-active" src={`/backgrounds/${backgroundImages[0]}`} alt="" decoding="async" />
      <img class="background-image" src={`/backgrounds/${backgroundImages[1]}`} alt="" decoding="async" />
    </div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>
      import '../scripts/site-visuals.ts';
    </script>
  </body>
</html>
