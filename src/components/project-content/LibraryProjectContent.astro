---
const { embedded = false } = Astro.props;
const TitleTag = embedded ? 'h2' : 'h1';
const media = [
  { src: '/images/local-music-library-home.png', alt: 'Local Music Library dashboard.', label: 'Dashboard and queue' },
  { src: '/images/local-music-library-library.png', alt: 'Local Music Library library view.', label: 'Library filters and ratings' },
  { src: '/images/local-music-library-subscriptions.png', alt: 'Local Music Library subscriptions view.', label: 'Subscriptions' },
];

---
<section class="project-hero" aria-labelledby="library-project-heading">
      <div class="project-hero__copy">
        <p class="eyebrow">Project · Local desktop tool</p>
        <TitleTag id="library-project-heading" class="project-title">Local Music Library</TitleTag>
        <p class="project-hero__lead">A local music library for saved links, playlists, and subscriptions.</p>
        <p>A browser extension captures YouTube and Bilibili pages. The Windows dashboard stores metadata in SQLite, manages the queue, and controls playback in a reused browser tab.</p>
        <div class="project-actions"><a class="button button--primary" href="https://github.com/Kaboomlolxd/Music-Library" target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="project-section project-section--closing" aria-labelledby="library-gallery-heading">
      <div class="section-heading"><h2 id="library-gallery-heading">Screens</h2></div>
      <div class="project-gallery">
        {media.map((item) => <figure><img src={item.src} alt={item.alt} loading="lazy" /><figcaption>{item.label}</figcaption></figure>)}
      </div>
    </section>

