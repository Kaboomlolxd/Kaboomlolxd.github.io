---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import '../styles/global.css';
---

<BaseLayout title="My projects | Portfolio" description="Selected software projects by Jincheng Shen.">
  <Header />
  <main id="main-content" class="project-browser">
    <section id="projects" class="content-section" aria-labelledby="projects-heading">
      <h1 id="projects-heading" class="projects-page-heading">My projects</h1>
      <div class="projects-grid projects-grid--portfolio">
        <ProjectCard
          title="RWKV SSD-streaming inference engine"
          description="An RWKV inference engine that streams model weights from SSD, using a manifest, bounded cache, and read-ahead path to keep memory use low."
          href="/projects/rwkv-ssd/"
          tags={['Python', 'C++', 'Inference', 'Storage']}
          mediaSlots={[{ kind: 'video', src: '/media/rwkv-ssd-video-sample.mp4', poster: '/images/rwkv-ssd-preview.jpg', label: 'RWKV SSD streaming walkthrough' }]}
        />
        <ProjectCard
          title="Local Music Library"
          description="A Windows music library for saved links and playlists, with SQLite storage, browser extension capture, and playback through a reused browser tab."
          href="/projects/local-music-library/"
          tags={['Windows', 'SQLite', 'Browser extension']}
          mediaSlots={[{ kind: 'image', src: '/images/local-music-library-home.png', alt: 'Local Music Library dashboard and playback queue', label: 'Dashboard and queue' }]}
        />
        <ProjectCard
          title="MIDI Piano Rhythm Game"
          description="A MIDI rhythm game with Web MIDI and keyboard input, a Pixi falling-note renderer, and a local chart and practice history."
          href="/projects/midi-piano-rhythm-game/"
          tags={['TypeScript', 'Svelte', 'Pixi', 'Web MIDI']}
          mediaSlots={[{ kind: 'video', src: '/media/piano-game-demo-web.mp4', poster: '/images/piano-game-preview.jpg', label: 'MIDI Piano Rhythm Game demo' }]}
        />
        <ProjectCard
          title="Combat Learning Agent"
          description="A group project using Unreal Engine Learning Agents and PPO to train an agent against a rule-based melee combat opponent."
          href="/projects/combat-learning-agent/"
          tags={['Group project', 'Unreal Engine 5', 'C++', 'Reinforcement learning']}
          mediaSlots={[{ kind: 'image', src: '/images/combat-learning-agent.jpg', alt: 'PPO interaction framework for the Combat Learning Agent', label: 'Agent interaction framework' }]}
        />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
